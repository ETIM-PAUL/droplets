# Errand settings. Copy to .env (gitignored) and fill in.
# Only VITE_ values reach the Mini App's browser code, so never put a key in one.

# RailKit API (apps/api).
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173
# Postgres for save codes, the pool's books and feedback. Without it the API keeps them in memory and loses them
# on restart; the pool worker won't start without it.
DATABASE_URL=
# Bearer token for the /v1/admin/ endpoints: registering paying apps, pausing the pool, unmatched payments, feedback.
ADMIN_TOKEN=
# Slack or Discord incoming webhook for alerts: the pool's settlements and payouts, and feedback.
ALERT_WEBHOOK_URL=

# Closed beta: an invite code is needed to open Errand. Generate codes with: node scripts/new-invites.mjs "Name" ...
BETA_REQUIRED=false
BETA_INVITES=
# Long random string; changing it signs everyone out.
SESSION_SECRET=

# OpenAI: platform.openai.com/api-keys. Optional: with the key empty, the chat uses its rules only.
OPENAI_API_KEY=
# Used when the chat's rules can't read a message or QR code, and for savings questions in other languages.
OPENAI_MODEL=gpt-4.1-mini
# At most this many model calls per UTC day, across all users (~$0.0003 each).
AGENT_MODEL_CALLS_PER_DAY=300

# Errand Save: save codes and Grow (the user's own staked NIM). The Mini App is savings only, so keep it on.
SAVE_ENABLED=true
# mainnet or testnet. Must match the Nimiq Pay network the Mini App runs on.
SAVE_NETWORK=testnet
# Nimiq node for stake lookups and receipt checks. Default: rpc.nimiqwatch.com or rpc.testnet.nimiqwatch.com.
NIMIQ_RPC_URL=
# Validators shown first when someone opens Grow, e.g. NQ26 0000 0000 02A5 YAK7 4QNF 9MH0 TE2B GVRU=Pool name
SAVE_VALIDATORS=

# Errand Save, feature 2: Steady and Boost (the two-sided pool). Errand holds this pool's NIM, so it stays off
# until the legal review. Mainnet also needs POOL_ALLOW_MAINNET=true. Same POOL_* values for the API and the worker.
POOL_ENABLED=false
POOL_NETWORK=testnet
# The pool's own Nimiq address. Deposits go here; the worker pays out from it.
POOL_ADDRESS=
# Worker only: the pool wallet's 32-byte key, as hex. Never give it to the API or the Mini App.
POOL_KEY=
# Daily at 12:00 UTC. On testnet a shorter step (e.g. 30) makes trying it out quicker.
POOL_SETTLE_EVERY_MINUTES=1440
POOL_SETTLE_AT_MINUTE_UTC=720
POOL_FEE_BPS_PER_YEAR=100
# Pilot caps. "none" removes one.
POOL_MAX_STEADY_USD_PER_ADDRESS=100
POOL_MAX_STEADY_USD_TOTAL=2000
POOL_MAX_BOOST_NIM_PER_ADDRESS=2000000
# Shows Steady and Boost inside Savings.
VITE_POOL_ENABLED=false

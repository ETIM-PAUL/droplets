# Phase 4 provider keys. Copy to .env (gitignored) and fill in. Server-side only: never prefix with VITE_.

# Mavapay: sign up at staging.mavapay.co (instant approval), sent as the x-api-key header. WRITE role needed for quotes.
MAVAPAY_API_KEY=
MAVAPAY_BASE_URL=https://staging.api.mavapay.co/api/v1
# live: https://api.mavapay.co/api/v1

# Bitrefill: bitrefill.com/account/developers (Personal key, Bearer auth).
BITREFILL_API_KEY=
BITREFILL_BASE_URL=https://api.bitrefill.com/v2

# Boltz: public API, no key. Override only if you self-host or use their testnet.
BOLTZ_API_URL=https://api.boltz.exchange/v2

# No public API or key found yet for LendaSwap, P2P.me or Machankura.
# Add variables here once the providers issue access.

# OpenAI: platform.openai.com/api-keys. Server-side only (agent, Phase 16+).
OPENAI_API_KEY=

# RailKit API (apps/api). CORRIDORS is the kill switch: only listed corridors are served.
CORRIDORS=ke-mpesa,ng-bank
ALLOWED_ORIGINS=http://localhost:5173
PORT=8787
# Set after registering our webhook with Mavapay (needs a public URL).
MAVAPAY_WEBHOOK_SECRET=

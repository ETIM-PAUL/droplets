# Droplets settings. Copy to .env (gitignored) and fill in.
# Only VITE_ values reach the Mini App's browser code, so never put a key in one.

# RailKit API (apps/api).
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173
# Postgres for save codes and feedback. Without it the API keeps them in memory and loses them on restart.
DATABASE_URL=
# Bearer token for the /v1/admin/ endpoints: registering paying apps, reading feedback, and paying draw prizes.
ADMIN_TOKEN=
# Slack or Discord incoming webhook. Feedback sent from the app, and each week's draw result, are posted here.
ALERT_WEBHOOK_URL=

# Closed beta: an invite code is needed to open Droplets. Generate codes with: node scripts/new-invites.mjs "Name" ...
BETA_REQUIRED=false
BETA_INVITES=
# Long random string; changing it signs everyone out.
SESSION_SECRET=

# OpenAI: platform.openai.com/api-keys. Optional: with the key empty, the chat uses its rules only.
OPENAI_API_KEY=
# Used when the chat's rules can't read a message or QR code, and for savings questions in other languages.
OPENAI_MODEL=gpt-4.1-mini
# At most this many model calls per UTC day, across all users (~$0.0003 each).
AGENT_MODEL_CALLS_PER_DAY=300

# Droplets: save codes and Grow (the user's own staked NIM). The Mini App is savings only, so keep it on.
SAVE_ENABLED=true
# mainnet or testnet. Must match the Nimiq Pay network the Mini App runs on.
SAVE_NETWORK=testnet
# Nimiq node for stake lookups and receipt checks. Default: rpc.nimiqwatch.com or rpc.testnet.nimiqwatch.com.
NIMIQ_RPC_URL=
# Validators shown first when someone opens Grow, e.g. NQ26 0000 0000 02A5 YAK7 4QNF 9MH0 TE2B GVRU=Pool name
SAVE_VALIDATORS=

# The weekly draw: keep at least PRIZE_MIN_NIM in Grow on PRIZE_DAYS of the 7 days to be in Sunday's draw at 23:59.
PRIZE_ENABLED=true
PRIZE_NIM=1000
PRIZE_MIN_NIM=1000
PRIZE_DAYS=4
# Minutes ahead of UTC for the week's days and the draw. 60 is West Africa Time, 180 East Africa Time.
PRIZE_UTC_OFFSET_MINUTES=60
# The prize wallet's address, so the API can check payouts. Its key stays with `pnpm pay-prizes` (in .env.prize),
# never the API. On testnet, the first `pnpm pay-prizes` makes the wallet and prints this address.
PRIZE_ADDRESS=

# The key Droplets gave you when Puddle Quiz was registered.
DROPLETS_KEY=
# Where the Droplets API runs.
DROPLETS_API_URL=https://droplets-api.onrender.com
# main (real NIM) or test.
NETWORK=main
# NIM per reward, and the most to pay out per day.
REWARD_NIM=5
DAILY_CAP_NIM=50
# Set to no to also accept plain Nimiq addresses (their owners are paid in full, nothing is saved).
# REQUIRE_DROPLETS=yes
# Only for hosts without a disk: the payout wallet's private key (hex). Otherwise one is made in .data/.
# PAYOUT_KEY=
